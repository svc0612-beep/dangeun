# 배포할 때 쓰는 설정 예시
# 이 파일을 복사해 .env 로 만들고 값을 채운 뒤,
# .env 는 절대 GitHub 에 올리지 말 것 (.gitignore 에 넣어둠)

# 실행 환경. production 으로 두면 안전 설정이 켜짐
#   - /docs 닫힘
#   - 비밀번호 재설정 코드가 화면에 안 나감
#   - 정해준 주소에서 오는 요청만 받음
DANGGEUN_ENV=production

# 토큰 서명 열쇠. 반드시 바꿔야 함.
# 만드는 법: python -c "import secrets; print(secrets.token_urlsafe(48))"
DANGGEUN_SECRET=여기에_무작위_긴_문자열

# 화면이 있는 주소. 쉼표로 여러 개 적을 수 있음
DANGGEUN_ORIGINS=https://내주소.com,https://www.내주소.com
